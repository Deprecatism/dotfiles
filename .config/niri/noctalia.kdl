layout {

    focus-ring {
        active-color   "#d2bbff"
        inactive-color "#15121a"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d2bbff"
        inactive-color "#15121a"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d2bbff"
        inactive-color "#5628a6"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d2bbff80"
    }
}

recent-windows {
    highlight {
        active-color "#d2bbff"
        urgent-color "#ffb4ab"
    }
}
